# Copy to .env for Docker Compose. Do not commit a populated .env file.

# PostgreSQL: use unique non-example values in production.
POSTGRES_DB=ai_social
POSTGRES_USER=ai_social
POSTGRES_PASSWORD=change-this-before-production
DATABASE_URL=postgresql+asyncpg://ai_social:change-this-before-production@postgres:5432/ai_social
DATABASE_URL_SYNC=postgresql+psycopg://ai_social:change-this-before-production@postgres:5432/ai_social

# Redis is internal to Docker Compose. Never expose it publicly in production.
REDIS_URL=redis://redis:6379/0

# Application security. Generate a long random value for production; it is not a password.
APP_ENV=development
APP_NAME=AI Social Automation
BACKEND_CORS_ORIGINS=http://localhost:3000
SESSION_COOKIE_NAME=ai_social_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=24

# Both values are optional. When unset, no initial user exists and login is unavailable.
# Set only in a private .env or secret manager, never in this example file.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Browser-visible value only: the frontend sends same-origin requests through its proxy.
NEXT_PUBLIC_APP_NAME=AI Social Automation
BACKEND_INTERNAL_URL=http://backend:8000
